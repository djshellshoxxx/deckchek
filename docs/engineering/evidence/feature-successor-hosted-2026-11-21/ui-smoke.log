nverters"},{"key":"line_in_impedance","label":"Line input impedance","value":47,"unit":"kOhm","tolerance":null,"source":"https://www.manualslib.com/manual/1300692/Native-Instruments-Audio-8-Dj.html","confidence":"unverified","notes":"Value taken from a search-result summary of the cited document; the primary document could not be opened during research (fetch blocked), so verify against the manual."},{"key":"phono_in_impedance","label":"Phono input impedance","value":"47 kOhm / 1 MOhm (as summarised)","unit":"","tolerance":null,"source":"https://www.manualslib.com/manual/1300692/Native-Instruments-Audio-8-Dj.html","confidence":"unverified","notes":"Value taken from a search-result summary of the cited document; the primary document could not be opened during research (fetch blocked), so verify against the manual."},{"key":"max_output","label":"Maximum output level","value":9.7,"unit":"dBu","tolerance":null,"source":"https://www.manualslib.com/manual/1300692/Native-Instruments-Audio-8-Dj.html","confidence":"unverified","notes":"Value taken from a search-result summary of the cited document; the primary document could not be opened during research (fetch blocked), so verify against the manual."},{"key":"thd_n","label":"Output THD+N","value":"0.008 - 0.012","unit":"%","tolerance":null,"source":"https://www.manualslib.com/manual/1300692/Native-Instruments-Audio-8-Dj.html","confidence":"unverified","notes":"Value taken from a search-result summary of the cited document; the primary document could not be opened during research (fetch blocked), so verify against the manual."},{"key":"dyn_range_out","label":"Output dynamic range","value":">100","unit":"dB","tolerance":null,"source":"https://www.manualslib.com/manual/1300692/Native-Instruments-Audio-8-Dj.html","confidence":"unverified","notes":"Value taken from a search-result summary of the cited document; the primary document could not be opened during research (fetch blocked), so verify against the manual."},{"key":"crosstalk","label":"Input crosstalk","value":"-87 (as summarised)","unit":"dB","tolerance":null,"source":"https://www.manualslib.com/manual/1300692/Native-Instruments-Audio-8-Dj.html","confidence":"unverified","notes":"Value taken from a search-result summary of the cited document; the primary document could not be opened during research (fetch blocked), so verify against the manual."},{"key":"bus_power","label":"Power","value":"USB bus powered","unit":"","tolerance":null,"source":"https://www.bhphotovideo.com/c/product/480075-REG/Native_Instruments_12872_Audio_8_DJ.html","confidence":"confirmed","notes":null}],"timecode":null,"midi":null,"tests":[{"id":"a8-driver-present","category":"driver","title":"Audio 8 DJ driver installed and healthy","why":"No driver, unsigned driver or an error state in Device Manager is the most common reason Traktor shows no Audio 8 DJ.","method":"driver:check","params":{},"steps":["Connect the Audio 8 DJ directly to a USB 2.0/3.0 port on the PC (no hub).","Run the driver check.","If missing, install the Traktor Audio 8 DJ driver and reboot."],"equipment":["Traktor Audio 8 DJ","USB cable"],"severity":"critical","software":"Traktor Pro","pass":{"metricId":"driver_present","op":"equals","value":1,"value2":null,"unit":"bool","source":"DeckChek logical presence check (not a published spec)"}},{"id":"a8-driver-signed","category":"driver","title":"Driver signature","why":"An unsigned or legacy driver may be blocked or crash on Windows 10/11 (Secure Boot / HVCI).","method":"driver:check","params":{},"steps":["Run the driver check and read the signature result."],"equipment":["Traktor Audio 8 DJ"],"severity":"major","software":null,"pass":{"metricId":"driver_signed","op":"equals","value":1,"value2":null,"unit":"bool","source":"DeckChek logical presence check (not a published spec)"}},{"id":"a8-driver-status","category":"driver","title":"Device status OK (no Code 10/43)","why":"Catches failed enumeration, power or cable faults.","method":"driver:check","params":{},"steps":["Run the driver check; open Device Manager if status is not OK."],"equipment":["Traktor Audio 8 DJ"],"severity":"major","software":null,"pass":{"metricId":"driver_status_ok","op":"equals","value":1,"value2":null,"unit":"bool","source":"DeckChek logical presence check (not a published spec)"}},{"id":"a8-asio-registered","category":"driver","title":"ASIO driver registered","why":"Traktor Scratch needs the ASIO driver to appear in Preferences > Audio Setup.","method":"driver:check","params":{},"steps":["Run the driver check.","In Traktor Preferences > Audio Setup the Audio Device list should show the Audio 8 DJ ASIO entry."],"equipment":["Traktor Audio 8 DJ"],"severity":"critical","software":"Traktor Pro","pass":{"metricId":"asio_registered","op":"equals","value":1,"value2":null,"unit":"bool","source":"DeckChek logical presence check (not a published spec)"}},{"id":"a8-usb-port","category":"usb","title":"USB port, cable and bus power","why":"The interface is USB bus powered; hubs, long cables or shared controllers cause dropouts and clicks.","method":"manual:inspection","params":{},"steps":["Use the supplied/short USB cable straight into the PC, not a hub or keyboard port.","Prefer a port on a different controller from other audio/USB-3 storage devices.","Flex the cable at the connector while audio plays: no dropouts.","Power LED on the unit stays steady."],"equipment":["USB cable"],"severity":"major","software":null,"pass":null},{"id":"a8-control-panel","category":"driver","title":"Control panel: sample rate, latency, software lock","why":"The control panel holds the latency/buffer setting and phono gain selectors; wrong values give clicks or low timecode level.","method":"manual:inspection","params":{},"steps":["Open the Audio 8 DJ control panel (Start menu / system tray).","Note the sample rate (44.1/48/96 kHz) and set it equal to the Traktor audio setup.","Set the latency to a value that plays 10 minutes of music without clicks.","Confirm the software-lock option is not blocking another application."],"equipment":["Traktor Audio 8 DJ"],"severity":"major","software":null,"pass":null},{"id":"a8-in12-line","category":"audio","title":"Signal health: Input 1/2 (Deck A) LINE","why":"Finds a dead channel, wrong switch position, bad RCA or noisy preamp for this input pair.","method":"quick:Signal health","params":{"input":"Input 1/2 (Deck A) LINE","mode":"line"},"steps":["Set the PHONO/LINE switch for this pair to LINE.","Feed a stereo line source (phone, CD player or mixer output) at nominal level.","Run the signal health test; both channels must show signal, similar level, no clipping or dropouts."],"equipment":["Audio source","RCA cables"],"severity":"major","software":null,"pass":null},{"id":"a8-in12-phono","category":"audio","title":"Signal health: Input 1/2 (Deck A) PHONO","why":"Finds a dead channel, wrong switch position, bad RCA or noisy preamp for this input pair.","method":"quick:Signal health","params":{"input":"Input 1/2 (Deck A) PHONO","mode":"phono"},"steps":["Set the PHONO/LINE switch for this pair to PHONO.","Connect a turntable with cartridge (ground wire attached) and play a 1 kHz / test record or music.","Check that the control-panel phono gain is set for your cartridge.","Run the signal health test; both channels must show signal, similar level, no clipping or dropouts."],"equipment":["Audio source","RCA cables","Turntable"],"severity":"major","software":null,"pass":null},{"id":"a8-in34-line","category":"audio","title":"Signal health: Input 3/4 (Deck B) LINE","why":"Finds a dead channel, wrong switch position, bad RCA or noisy preamp for this input pair.","method":"quick:Signal health","params":{"input":"Input 3/4 (Deck B) LINE","mode":"line"},"steps":["Set the PHONO/LINE switch for this pair to LINE.","Feed a stereo line source (phone, CD player or mixer output) at nominal level.","Run the signal health test; both channels must show signal, similar level, no clipping or dropouts."],"equipment":["Audio source","RCA cables"],"severity":"major","software":null,"pass":null},{"id":"a8-in34-phono","category":"audio","title":"Signal health: Input 3/4 (Deck B) PHONO","why":"Finds a dead channel, wrong switch position, bad RCA or noisy preamp for this input pair.","method":"quick:Signal health","params":{"input":"Input 3/4 (Deck B) PHONO","mode":"phono"},"steps":["Set the PHONO/LINE switch for this pair to PHONO.","Connect a turntable with cartridge (ground wire attached) and play a 1 kHz / test record or music.","Check that the control-panel phono gain is set for your cartridge.","Run the signal health test; both channels must show signal, similar level, no clipping or dropouts."],"equipment":["Audio source","RCA cables","Turntable"],"severity":"major","software":null,"pass":null},{"id":"a8-in56-line","category":"audio","title":"Signal health: Input 5/6 LINE","why":"Finds a dead channel, wrong switch position, bad RCA or noisy preamp for this input pair.","method":"quick:Signal health","params":{"input":"Input 5/6 LINE","mode":"line"},"steps":["Set the PHONO/LINE switch for this pair to LINE.","Feed a stereo line source (phone, CD player or mixer output) at nominal level.","Run the signal health test; both channels must show signal, similar level, no clipping or dropouts."],"equipment":["Audio source","RCA cables"],"severity":"major","software":null,"pass":null},{"id":"a8-in78-line","category":"audio","title":"Signal health: Input 7/8 LINE","why":"Finds a dead channel, wrong switch position, bad RCA or noisy preamp for this input pair.","method":"quick:Signal health","params":{"input":"Input 7/8 LINE","mode":"line"},"steps":["Set the PHONO/LINE switch for this pair to LINE.","Feed a stereo line source (phone, CD player or mixer output) at nominal level.","Run the signal health test; both channels must show signal, similar level, no clipping or dropouts."],"equipment":["Audio source","RCA cables"],"severity":"major","software":null,"pass":null},{"id":"a8-out1","category":"audio","title":"Signal health: output pair 1/2","why":"Verifies each analog output pair passes a clean stereo signal.","method":"quick:Signal health","params":{"output":"Out 1-2","loopback":true},"steps":["Patch Out 1-2 RCA to a free line input of the Audio 8 DJ (loopback) or to a mixer channel and record that.","Play a 1 kHz tone/music from the DJ app to this output only.","Run the signal health test and confirm both channels equal."],"equipment":["RCA loopback cables"],"severity":"minor","software":null,"pass":null},{"id":"a8-out3","category":"audio","title":"Signal health: output pair 3/4","why":"Verifies each analog output pair passes a clean stereo signal.","method":"quick:Signal health","params":{"output":"Out 3-4","loopback":true},"steps":["Patch Out 3-4 RCA to a free line input of the Audio 8 DJ (loopback) or to a mixer channel and record that.","Play a 1 kHz tone/music from the DJ app to this output only.","Run the signal health test and confirm both channels equal."],"equipment":["RCA loopback cables"],"severity":"minor","software":null,"pass":null},{"id":"a8-out5","category":"audio","title":"Signal health: output pair 5/6","why":"Verifies each analog output pair passes a clean stereo signal.","method":"quick:Signal health","params":{"output":"Out 5-6","loopback":true},"steps":["Patch Out 5-6 RCA to a free line input of the Audio 8 DJ (loopback) or to a mixer channel and record that.","Play a 1 kHz tone/music from the DJ app to this output only.","Run the signal health test and confirm both channels equal."],"equipment":["RCA loopback cables"],"severity":"minor","software":null,"pass":null},{"id":"a8-out7","category":"audio","title":"Signal health: output pair 7/8","why":"Verifies each analog output pair passes a clean stereo signal.","method":"quick:Signal health","params":{"output":"Out 7-8","loopback":true},"steps":["Patch Out 7-8 RCA to a free line input of the Audio 8 DJ (loopback) or to a mixer channel and record that.","Play a 1 kHz tone/music from the DJ app to this output only.","Run the signal health test and confirm both channels equal."],"equipment":["RCA loopback cables"],"severity":"minor","software":null,"pass":null},{"id":"a8-phono-separation","category":"cartridge","title":"Phono channel separation (cartridge + preamp)","why":"Distinguishes cartridge/wiring crosstalk from preamp or input faults.","method":"cartridge:Channel separation","params":{"source":"test record L-only/R-only band","input":"phono"},"steps":["Set the deck input to PHONO.","Play the left-only then right-only band of a test record.","Run the test for each deck."],"equipment":["Turntable","Test record with L/R separation bands"],"severity":"minor","software":null,"pass":null},{"id":"a8-phono-hum","category":"safety","title":"Ground and hum on phono inputs","why":"A floating turntable ground gives 50/60 Hz hum, only visible on phono inputs.","method":"quick:Ground & hum","params":{"input":"phono"},"steps":["Connect turntable ground wire to the interface ground terminal.","Lift the stylus, start the platter, run the test.","Compare with ground wire disconnected to prove it is ground related."],"equipment":["Turntable"],"severity":"major","software":null,"pass":null},{"id":"a8-line-noise","category":"audio","title":"Noise floor with inputs open (line)","why":"Establishes the idle noise of the line inputs/converters.","method":"quick:Signal health","params":{"input":"line","silence":true},"steps":["Disconnect all cables from the line inputs, set switch to LINE.","Run signal health and read noise floor."],"equipment":["Traktor Audio 8 DJ"],"severity":"minor","software":null,"pass":null},{"id":"a8-latency","category":"latency","title":"Round-trip latency at chosen buffer","why":"DVS needs low latency for tight scratching.","method":"manual:inspection","params":{"measure":"round-trip loopback"},"steps":["Loop output 1/2 to input 1/2 (LINE).","Set the control-panel latency to your working setting.","In Traktor Audio Setup read the reported latency (ms)."],"equipment":["RCA loopback cable"],"severity":"minor","software":"Traktor Pro","pass":null},{"id":"a8-midi-din","category":"midi","title":"DIN MIDI in/out through-port","why":"The MIDI DIN ports are only shown to Windows through the driver; a dead port breaks external gear sync.","method":"midi:coverage","params":{"groups":["DIN MIDI"]},"steps":["Connect a MIDI cable from DIN OUT to DIN IN (loop), or an external controller/keyboard to DIN IN.","Send notes from the controller or from a MIDI tool and exercise each key/control.","Check the messages are seen without unexpected data."],"equipment":["MIDI DIN cable","Controller or keyboard"],"severity":"minor","software":null,"pass":{"metricId":"midi_controls_seen_percent","op":">=","value":100,"value2":null,"unit":"%","source":"DeckChek logical check"}},{"id":"a8-tc-mk2","category":"timecode","title":"Timecode format check: Traktor Scratch MK2 through phono input","why":"Confirms the interface preamp delivers a valid 2-channel quadrature timecode.","method":"timecode:format-check","params":{"format":"Traktor Scratch MK2","nominalRpm":33.333333},"steps":["Set input to PHONO (vinyl) or LINE (CDJ).","Play MK2 control vinyl at 33 1/3, stylus in the lead-in or plain area.","Run the check on each deck."],"equipment":["Traktor Scratch MK2 control vinyl","Turntable"],"severity":"major","software":"Traktor Pro","pass":null},{"id":"a8-tc-mk1","category":"timecode","title":"Timecode format check: Traktor Scratch MK1","why":"Same for MK1 vinyl.","method":"timecode:format-check","params":{"format":"Traktor Scratch MK1","nominalRpm":33.333333},"steps":["Play MK1 control vinyl as above."],"equipment":["Traktor Scratch MK1 control vinyl"],"severity":"minor","software":"Traktor Pro","pass":null},{"id":"a8-dvs","category":"dvs","title":"DVS signal integrity (both decks)","why":"Detects dropouts, level imbalance, dirty needle on real vinyl or CD.","method":"dvs:DVS signal","params":{},"steps":["Play control media on Deck A, run, repeat for Deck B."],"equipment":["Traktor control vinyl or CD"],"severity":"major","software":"Traktor Pro","pass":null},{"id":"a8-sw-traktor","category":"software","title":"Traktor Pro install and crash/log scan","why":"Traktor crash logs often name the audio driver.","method":"software:check","params":{"software":"Traktor Pro"},"steps":["Run the software check after a play session."],"equipment":["Traktor Pro"],"severity":"minor","software":"Traktor Pro","pass":{"metricId":"software_installed","op":"equals","value":1,"value2":null,"unit":"bool","source":"DeckChek logical check"}},{"id":"a8-jacks","category":"mechanical","title":"Jacks and switches inspection","why":"Worn RCAs and switch contacts cause crackle.","method":"manual:inspection","params":{},"steps":["Wiggle each RCA plug in its socket while audio plays: no crackle.","Toggle each PHONO/LINE switch and confirm it clicks to both positions.","Check the headphone jack and the ground terminal tighten correctly.","Check the case for cracks and USB socket for play."],"equipment":["Traktor Audio 8 DJ"],"severity":"minor","software":null,"pass":null},{"id":"a8-headphone","category":"audio","title":"Headphone output","why":"Confirms the headphone amp and any monitor routing.","method":"manual:inspection","params":{},"steps":["Connect headphones to the front headphone jack.","Play music; check both channels, clean level control, no hiss."],"equipment":["Headphones"],"severity":"minor","software":null,"pass":null}]},{"schemaVersion":1,"id":"traktor-scratch-timecode","manufacturer":"Native Instruments","model":"Traktor Scratch Control Vinyl MK2","aliases":["Traktor Scratch MK2","Traktor Scratch Pro control vinyl MK2","Traktor Scratch control vinyl","Traktor Scratch MK1 vinyl","Traktor Scratch control CD"],"category":"timecode-media","summary":"Native Instruments Traktor Scratch control vinyl MK2 (the owner's timecode record) for Traktor Scratch Pro / Traktor Pro; MK1 vinyl and the control CD are listed as secondary formats.","identityNotes":"Confirmed by the owner: the control vinyl is Traktor Scratch Control Vinyl MK2. MK1 and the control CD stay listed as secondary formats (modern Traktor Pro reads both). MK2 carrier: Mixxx's Traktor MK2 work (PR 14569, DVS internals Pt. 3) and xwax list discussion give 2500 Hz, which the tests use; an older retailer text says 2 kHz (that is the MK1 value). The 2500 Hz MK2 carrier, 3000 Hz MK2 CD carrier and side lengths are confirmed from xwax timecoder.c (traktor_mk2_a/b/cd) as vendored in Mixxx. The MK1 control CD carrier is still unknown. Lead-in length is not confirmed.","image":{"file":"traktor-scratch-timecode.svg","kind":"illustration","source":"original DeckChek illustration","license":"original work","author":"DeckChek"},"documents":[{"title":"Mixxx PR 14569: Initial Traktor MK2 vinyl/CD support","type":"support-article","url":"https://github.com/mixxxdj/mixxx/pull/14569","language":"en","notes":"MK2 timecode definitions; 2500 Hz carrier (from search snippet; page not opened)."},{"title":"xwax-devel: Traktor scratch mk2 vinyl","type":"support-article","url":"https://sourceforge.net/p/xwax/mailman/message/29827458/","language":"en","notes":"Mailing-list discussion; resolution 2500 in traktor_b fixed speed (search snippet)."},{"title":"DJ TechTools: timecode explained","type":"support-article","url":"https://djtechtools.com/2009/08/03/timecode-exlplained-basic","language":"en","notes":"General timecode explanation, 2 kHz Traktor carrier."},{"title":"DJ TechTools forum: Traktor control vinyl MK1 and MK2","type":"support-article","url":"https://forum.djtechtools.com/t/traktor-control-vinyl-mk1-and-mk2/68964","language":"en","notes":"Community comparison."},{"title":"NI Traktor Pro 3 timecode setup guide","type":"support-article","url":"https://support.native-instruments.com/support/solutions/articles/69000879426-traktor-pro-3-timecode-setup-guide","language":"en","notes":"Official setup/calibration steps."},{"title":"NI: Traktor crashes (log location)","type":"support-article","url":"https://support.native-instruments.com/support/solutions/articles/69000882545-traktor-crashes","language":"en","notes":"Mentions Documents/Native Instruments/Traktor X/Logs."},{"title":"PSSL: Traktor Scratch MK2 vinyl","type":"spec-sheet","url":"https://www.pssl.com/products/ni-traktor-scratch-pro-control-vinyl-mk2-white","language":"en","notes":"Retailer marketing text."}],"connectivity":{"usb":null,"midi":null,"audio":null,"analog":["2-channel stereo timecode signal read as phono or line"]},"drivers":[],"software":[{"name":"Traktor Pro","role":"dvs","minVersion":"Traktor Scratch Pro 2 or later for MK2","notes":"Preferences > Timecode Setup (select MK1/MK2, calibrate, per-deck input), Preferences > Audio Setup, Deck 'Absolute/Relative/Internal' mode buttons. Logs under Documents\\Native Instruments\\Traktor <version>\\Logs."},{"name":"Traktor Scratch Pro","role":"dvs","minVersion":null,"notes":"Older name of the DVS licence; TSP2 reads MK1 and MK2."}],"specs":[{"key":"mk1_carrier_hz","label":"MK1 carrier frequency","value":2000,"unit":"Hz","tolerance":null,"source":"https://djtechtools.com/2009/08/03/timecode-exlplained-basic","confidence":"confirmed","notes":"Described as two sine waves of 2 kHz; Serato is 1 kHz."},{"key":"mk2_carrier_hz","label":"MK2 carrier frequency","value":2500,"unit":"Hz","tolerance":null,"source":"xwax lib/xwax/timecoder.c as vendored in Mixxx (timecode definitions) traktor_mk2_a/traktor_mk2_b, resolution 2500","confidence":"confirmed","notes":"xwax resolution 2500 for traktor_mk2_a/b (cycles per second at 33 1/3 rpm). The retailer text (PSSL) saying 2 kHz is the MK1 value."},{"key":"quadrature","label":"Phase relation","value":"90","unit":"deg","tolerance":null,"source":"https://mixxx.org/news/2025-08-27-dvs-internals-pt3/","confidence":"unverified","notes":"Standard for stereo timecode (quadrature sine pair); source not opened."},{"key":"mk2_side_a_min","label":"MK2 side A timecode length","value":12.3,"unit":"min","tolerance":null,"source":"xwax lib/xwax/timecoder.c as vendored in Mixxx (timecode definitions) traktor_mk2_a length 1845000 cycles / 2500 Hz = 738 s","confidence":"confirmed","notes":"Side B 17.3 min (2590000 cycles)."},{"key":"mk2_side_b_min","label":"MK2 side B timecode length","value":17.3,"unit":"min","tolerance":null,"source":"xwax lib/xwax/timecoder.c as vendored in Mixxx (timecode definitions) traktor_mk2_b length 2590000 cycles / 2500 Hz = 1036 s","confidence":"confirmed","notes":null},{"key":"mk2_cd_carrier_hz","label":"MK2 control CD carrier frequency","value":3000,"unit":"Hz","tolerance":null,"source":"xwax lib/xwax/timecoder.c as vendored in Mixxx (timecode definitions) traktor_mk2_cd, resolution 3000","confidence":"confirmed","notes":"MK2 CD code length 4500000 cycles = 25.0 min. The MK1 control CD carrier is not in xwax."},{"key":"modes","label":"Tracking modes","value":"Absolute, Relative, Internal","unit":"","tolerance":null,"source":"https://support.native-instruments.com/support/solutions/articles/69000879426-traktor-pro-3-timecode-setup-guide","confidence":"confirmed","notes":null}],"timecode":{"formats":[{"name":"Traktor Scratch MK2","vendor":"Native Instruments","carrierHz":2500,"atRpm":33.333,"quadrature":true,"leadInSec":null,"notes":"Owner format. 2500 Hz carrier (xwax traktor_mk2_a/b, 110-bit code with offset modulation). Side A 12.3 min (1845000 cycles), side B 17.3 min (2590000 cycles).","source":"xwax lib/xwax/timecoder.c as vendored in Mixxx (timecode definitions); https://mixxx.org/news/2025-08-27-dvs-internals-pt3/","confidence":"confirmed"},{"name":"Traktor Scratch MK1","vendor":"Native Instruments","carrierHz":2000,"atRpm":33.333,"quadrature":true,"leadInSec":null,"notes":"Secondary format (older MK1 vinyl). Absolute and relative modes supported.","source":"xwax lib/xwax/timecoder.c as vendored in Mixxx (timecode definitions) traktor_a/traktor_b (resolution 2000); https://djtechtools.com/2009/08/03/timecode-exlplained-basic","confidence":"confirmed"},{"name":"Traktor Scratch MK2 CD","vendor":"Native Instruments","carrierHz":3000,"atRpm":33.333,"quadrature":true,"leadInSec":null,"notes":"Traktor Scratch MK2 control CD: 3000 Hz carrier, 4500000 cycles = 25.0 min (xwax traktor_mk2_cd). Played at nominal speed 0 pitch.","source":"xwax lib/xwax/timecoder.c as vendored in Mixxx (timecode definitions)","confidence":"confirmed"},{"name":"Traktor Scratch MK1 CD","vendor":"Native Instruments","carrierHz":null,"atRpm":null,"quadrature":true,"leadInSec":null,"notes":"MK1 control CD: carrier not in xwax timecoder.c and no other source; unknown.","source":null,"confidence":"unverified"}]},"midi":null,"tests":[{"id":"tc-mk2-format","category":"timecode","title":"Traktor Scratch MK2 format check (33 1/3)","why":"Carrier frequency, quadrature phase, L/R balance and SNR show whether the vinyl, cartridge and input stage deliver a decodable signal.","method":"timecode:format-check","params":{"format":"Traktor Scratch MK2","nominalRpm":33.333333},"steps":["Clean the record and stylus.","Play the timecode side on a turntable at 33 1/3 rpm, pitch 0.","Run the check for at least 20 s per deck."],"equipment":["Traktor Scratch MK2 control vinyl","Turntable","Phono/line input of a DVS interface"],"severity":"major","software":"Traktor Pro","pass":null},{"id":"tc-mk2-45","category":"timecode","title":"Traktor Scratch MK2 at 45 rpm","why":"Speed tracking at 45 rpm (carrier scales with speed).","method":"timecode:format-check","params":{"format":"Traktor Scratch MK2","nominalRpm":45},"steps":["Set the deck to 45 rpm and repeat the format check."],"equipment":["Traktor Scratch MK2 control vinyl"],"severity":"minor","software":"Traktor Pro","pass":null},{"id":"tc-mk1-format","category":"timecode","title":"Traktor Scratch MK1 (secondary) format check (33 1/3)","why":"Carrier frequency, quadrature phase, L/R balance and SNR show whether the vinyl, cartridge and input stage deliver a decodable signal.","method":"timecode:format-check","params":{"format":"Traktor Scratch MK1","nominalRpm":33.333333},"steps":["Clean the record and stylus.","Play the timecode side on a turntable at 33 1/3 rpm, pitch 0.","Run the check for at least 20 s per deck."],"equipment":["Traktor Scratch MK1 control vinyl","Turntable","Phono/line input of a DVS interface"],"severity":"major","software":"Traktor Pro","pass":null},{"id":"tc-mk1-45","category":"timecode","title":"Traktor Scratch MK1 (secondary) at 45 rpm","why":"Speed tracking at 45 rpm (carrier scales with speed).","method":"timecode:format-check","params":{"format":"Traktor Scratch MK1","nominalRpm":45},"steps":["Set the deck to 45 rpm and repeat the format check."],"equipment":["Traktor Scratch MK1 control vinyl"],"severity":"minor","software":"Traktor Pro","pass":null},{"id":"tc-dvs-signal","category":"dvs","title":"DVS signal: both decks","why":"Generic integrity of the sine pair: dropouts, imbalance, noise.","method":"dvs:DVS signal","params":{},"steps":["Play control media on each deck for a full minute.","Run DVS signal and read dropouts/level."],"equipment":["Control vinyl or CD"],"severity":"major","software":"Traktor Pro","pass":null},{"id":"tc-vinyl-scan","category":"dvs","title":"Vinyl side scan for damage","why":"Scratches, warps or wear cause dropouts at a repeatable position on the side.","method":"vinyl:Vinyl side scan","params":{},"steps":["Play the full timecode side from lead-in to end while the app records.","Note positions of dropouts and compare with visible damage."],"equipment":["Control vinyl"],"severity":"minor","software":"Traktor Pro","pass":null},{"id":"tc-sep","category":"cartridge","title":"Cartridge channel separation with control vinyl","why":"Channel crosstalk >~ 20 dB destroys quadrature decoding.","method":"cartridge:Channel separation","params":{"source":"timecode"},"steps":["Play the timecode side; run the test."],"equipment":["Control vinyl","Turntable"],"severity":"minor","software":null,"pass":null},{"id":"tc-pitch","category":"speed","title":"Speed accuracy from timecode carrier","why":"A turntable running fast/slow shows up as carrier shift; compare against nominal pitch 0 and platter speed.","method":"speed:Speed & pitch","params":{"referenceHz":null,"nominalRpm":33.333333,"note":"reference carrier for the medium in use, see timecode block"},"steps":["Select the medium carrier frequency in the app (MK1 vs MK2).","Run at 33 1/3 and 45 rpm."],"equipment":["Control vinyl"],"severity":"minor","software":"Traktor Pro","pass":null},{"id":"tc-cal","category":"software","title":"Timecode calibration in Traktor","why":"The Timecode Setup panel measures the signal and sets input gain; it fails on bad signal/wiring.","method":"manual:inspection","params":{},"steps":["In Traktor open Preferences > Timecode Setup, pick MK1 or MK2 for each deck.","Start playback of the timecode and press Calibrate; wait until both L and R scopes are a clean circle.","Note the signal quality shown and adjust the input gain/phono-line setting if it fails.","Test Absolute, Relative and Internal modes by loading a track and watching the deck."],"equipment":["Traktor Pro","Control media"],"severity":"major","software":"Traktor Pro","pass":null},{"id":"tc-sw-check","category":"software","title":"Traktor install and log scan","why":"Looks for crashes and log errors around audio device and timecode errors.","method":"software:check","params":{"software":"Traktor Pro"},"steps":["Run the software check.","Open Documents\\Native Instruments\\Traktor <ver>\\Logs for details."],"equipment":["Traktor Pro"],"severity":"minor","software":"Traktor Pro","pass":{"metricId":"software_installed","op":"equals","value":1,"value2":null,"unit":"bool","source":"DeckChek logical check"}},{"id":"tc-abs-lead","category":"timecode","title":"Absolute mode and lead-in sanity","why":"Absolute mode only works when the needle lands in the timecode area; positions repeat across the lead-in.","method":"manual:inspection","params":{},"steps":["Drop the needle at the very start of the side and note Traktor shows a start position.","Drop in the middle: absolute position should match the same groove position each time.","Lift/replace at the end of the side."],"equipment":["Control vinyl"],"severity":"minor","software":"Traktor Pro","pass":null},{"id":"tc-visual","category":"mechanical","title":"Record condition","why":"Warp, scratches and dust are the usual cause of timecode loss.","method":"manual:inspection","params":{},"steps":["Inspect both sides for scratches, warp and dust.","Check the record sits flat on the platter with a slipmat.","Compare two copies if available."],"equipment":["Control vinyl"],"severity":"minor","software":null,"pass":null}]}],"createAssets":false}}
