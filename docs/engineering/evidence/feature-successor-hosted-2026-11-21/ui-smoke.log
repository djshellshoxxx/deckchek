","value":1350,"unit":"Hz","tolerance":null,"source":"Derived: carrier = xwax resolution (1000) x playback speed (timecoder_get_resolution, lib/xwax/timecoder.h); 45/33.333 = 1.35","confidence":"confirmed","notes":"Proportional scaling per xwax timecoder_get_resolution (resolution x speed)."},{"key":"quadrature","label":"L/R phase offset","value":90,"unit":"deg","tolerance":null,"source":"General quadrature principle (mixxx.org series)","confidence":"unverified","notes":null},{"key":"side_7in","label":"7in side length","value":4,"unit":"min","tolerance":null,"source":"Thomann listing (search snippet)","confidence":"unverified","notes":null},{"key":"noisemap_level","label":"NoiseMap level vs prior","value":6,"unit":"dB","tolerance":null,"source":"Thomann listing (search snippet)","confidence":"unverified","notes":"Remastered 6 dB louder."}],"timecode":{"formats":[{"name":"Serato CV02.5","vendor":"Serato","carrierHz":1000,"atRpm":33.333,"quadrature":true,"leadInSec":null,"notes":"NoiseMap control tone; lead-in length not found.","source":"xwax lib/xwax/timecoder.c as vendored in Mixxx (timecode definitions) serato_2a/serato_2b (carrier 1000 Hz only; NoiseMap code is not stated)","confidence":"confirmed"}]},"midi":null,"tests":[{"id":"cv-format","category":"timecode","title":"Timecode format check CV02.5 at 33 1/3","why":"Confirms carrier frequency, phase and balance.","method":"timecode:format-check","params":{"format":"Serato CV02.5","nominalRpm":33.333333},"steps":["Place vinyl on a turntable at 33, quartz lock, pitch 0.","Connect turntable to DVS interface line/phono per its setting.","Start the test and play the signal ~30 s."],"equipment":["Serato CV02.5 vinyl, turntable"],"severity":"critical","software":null,"pass":null},{"id":"cv-carrier","category":"timecode","title":"Carrier frequency","why":"Detects wrong format or wrong speed.","method":"timecode:format-check","params":{"format":"Serato CV02.5","nominalRpm":33.333333},"steps":["As above."],"equipment":["CV02.5 vinyl"],"severity":"major","software":null,"pass":null},{"id":"cv-quadrature","category":"timecode","title":"Quadrature phase 90 degrees","why":"Phase error causes direction errors.","method":"timecode:format-check","params":{"format":"Serato CV02.5","nominalRpm":33.333333},"steps":["As above."],"equipment":["CV02.5 vinyl"],"severity":"major","software":null,"pass":null},{"id":"cv-balance","category":"timecode","title":"L/R amplitude balance","why":"Imbalance suggests cartridge fault or vinyl wear.","method":"timecode:format-check","params":{"format":"Serato CV02.5","nominalRpm":33.333333},"steps":["As above."],"equipment":[],"severity":"major","software":null,"pass":null},{"id":"cv-snr","category":"timecode","title":"Carrier SNR","why":"Low SNR indicates wear, dirt or noise.","method":"timecode:format-check","params":{"format":"Serato CV02.5","nominalRpm":33.333333},"steps":["As above."],"equipment":[],"severity":"major","software":null,"pass":null},{"id":"cv-dropouts","category":"timecode","title":"Dropouts","why":"Dropouts cause timecode loss.","method":"timecode:format-check","params":{"format":"Serato CV02.5","nominalRpm":33.333333},"steps":["Play the whole side or at least 2 minutes."],"equipment":[],"severity":"major","software":null,"pass":null},{"id":"cv-45","category":"timecode","title":"45 rpm behaviour","why":"Vinyl should be playable at 45; carrier scales with speed.","method":"timecode:format-check","params":{"format":"Serato CV02.5","nominalRpm":45},"steps":["Set turntable to 45 rpm and repeat."],"equipment":["CV02.5 vinyl"],"severity":"minor","software":null,"pass":null},{"id":"cv-dvs","category":"dvs","title":"DVS signal integrity","why":"General sine-pair check.","method":"dvs:DVS signal","params":{},"steps":["Play timecode on each deck."],"equipment":[],"severity":"major","software":null,"pass":null},{"id":"cv-side-scan","category":"dvs","title":"Vinyl side scan","why":"Walks the side to find worn/damaged zones and the lead-in.","method":"vin