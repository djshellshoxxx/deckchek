rce":"Generic Windows driver health"}},{"id":"twelve-usb-enum","category":"usb","title":"USB enumeration & cable","why":"Intermittent disconnects point to cable, port or power faults.","method":"manual:inspection","params":{},"steps":["Plug into a rear USB port; try a second port and a different USB-C cable.","Move the platter and tap buttons while watching for disconnect chimes.","Confirm the unit stays in Device Manager / MIDI port list for 2 minutes."],"equipment":["Spare USB-C cable"],"severity":"major","software":null,"pass":null},{"id":"twelve-software-serato","category":"software","title":"Serato DJ Pro detects Twelve MK2","why":"Native support requires current Serato DJ Pro.","method":"software:check","params":{"software":"Serato DJ Pro"},"steps":["Install current Serato DJ Pro.","Run the software check; then launch Serato with the Twelve connected."],"equipment":[],"severity":"major","software":"Serato DJ Pro","pass":{"metricId":"software_installed","op":"equals","value":1,"value2":null,"unit":null,"source":"Serato DJ Pro supports the Twelve MK2 natively (Rane product page, unverified wording)"}},{"id":"twelve-software-crash","category":"software","title":"DJ software stability","why":"Repeated crashes with the controller attached suggest driver or USB problems.","method":"software:check","params":{"software":"Serato DJ Pro"},"steps":["Run the check."],"equipment":[],"severity":"minor","software":"Serato DJ Pro","pass":null},{"id":"twelve-midi-coverage","category":"midi","title":"MIDI coverage: all controls","why":"Finds dead buttons, pads or strip zones and learns unknown messages.","method":"midi:coverage","params":{},"steps":["Open the test and touch/press every control once, including shifted functions.","Rotate the platter both ways, touch the strip search end to end, move the pitch fader fully."],"equipment":[],"severity":"major","software":null,"pass":{"metricId":"midi_controls_seen_percent","op":">=","value":100,"value2":null,"unit":"%","source":"All controls should respond"}},{"id":"twelve-midi-unexpected","category":"midi","title":"Unexpected MIDI messages","why":"Stray messages while idle indicate noisy sensors.","method":"midi:coverage","params":{},"steps":["Hands off the unit for 30 seconds with the platter stopped."],"equipment":[],"severity":"minor","software":null,"pass":null},{"id":"twelve-pitch-fader","category":"midi","title":"Pitch fader sweep & resolution","why":"Dirty or worn track causes jumps; resolution determines fine pitch control.","method":"midi:fader","params":{"controlId":"pitch_fader"},"steps":["Move the pitch fader slowly end to end and back three times.","Repeat on each pitch range if the range changes the message."],"equipment":[],"severity":"major","software":null,"pass":null},{"id":"twelve-pitch-fader-res","category":"midi","title":"Pitch fader resolution (bits)","why":"Reports whether 7- or 14-bit; informational as manufacturer value unpublished.","method":"midi:fader","params":{"controlId":"pitch_fader"},"steps":["Sweep slowly at the lowest speed you can."],"equipment":[],"severity":"minor","software":null,"pass":null},{"id":"twelve-pitch-jitter","category":"midi","title":"Pitch fader jitter at rest","why":"Jitter makes tempo wander in software.","method":"midi:fader","params":{"controlId":"pitch_fader"},"steps":["Leave the fader at a fixed position for 20 seconds."],"equipment":[],"severity":"minor","software":null,"pass":null},{"id":"twelve-platter-rev","category":"midi","title":"Platter position resolution (ticks/rev)","why":"Low resolution makes scratching feel steppy.","method":"midi:jog","params":{"controlId":"platter_motion"},"steps":["With motor off, turn the platter one slow full revolution clockwise, then one anticlockwise."],"equipment":[],"severity":"major","software":null,"pass":null},{"id":"twelve-platter-dir","category":"midi","title":"Platter direction errors","why":"Direction flips indicate encoder faults.","method":"midi:jog","params":{"controlId":"platter_motion"},"steps":["Slow revolution each way."],"equipment":[],"severity":"major","software":null,"pass":{"metricId":"midi_jog_direction_errors","op":"<=","value":0,"value2":null,"unit":null,"source":"Direction must be consistent"}},{"id":"twelve-platter-touch","category":"midi","title":"Platter touch sensing","why":"Needed for scratch mode engage/release.","method":"midi:button","params":{"controlIds":["platter_touch"]},"steps":["Touch and release the platter top repeatedly."],"equipment":[],"severity":"major","software":null,"pass":{"metricId":"midi_button_stuck","op":"<=","value":0,"value2":null,"unit":null,"source":"No stuck state"}},{"id":"twelve-buttons","category":"midi","title":"Buttons: bounce & stuck","why":"Chatter causes double triggers.","method":"midi:button","params":{},"steps":["Press each button 5 times at normal pace."],"equipment":[],"severity":"minor","software":null,"pass":null},{"id":"twelve-leds","category":"midi","title":"LED feedback","why":"Verifies host-to-device MIDI output.","method":"midi:led","params":{},"steps":["Confirm each lit button/pad changes as the app commands."],"equipment":[],"severity":"minor","software":null,"pass":null},{"id":"twelve-midi-jitter","category":"latency","title":"MIDI timing jitter during platter motion","why":"Jitter in platter messages causes uneven scratch feel.","method":"midi:latency","params":{},"steps":["Spin the platter at constant speed (or let the motor run) for 15 seconds."],"equipment":[],"severity":"minor","software":null,"pass":null},{"id":"twelve-strip","category":"midi","title":"Strip search full length","why":"Dead spots on the touch strip prevent track searching.","method":"midi:fader","params":{"controlId":"strip_search"},"steps":["Slide a finger along the strip end to end slowly, three times."],"equipment":[],"severity":"minor","software":null,"pass":null},{"id":"twelve-speed-3345","category":"speed","title":"Motor speed 33 1/3 and 45 rpm","why":"Speed error causes pitch mismatch vs software deck.","method":"speed:Speed & pitch","params":{"nominalRpm":33.333333},"steps":["Place a Serato CV02.5 (or 1 kHz-referenced signal source such as a timecode disc under lines) on the platter if a timecode-reading path is available; otherwise use a strobe disc.","Select 33, measure; repeat at 45 with nominalRpm 45."],"equipment":["Reference record or strobe disc"],"severity":"major","software":null,"pass":null},{"id":"twelve-startup-brake","category":"speed","title":"Start-up and brake time","why":"Slow start or sticky brake affects mixing and stop effects.","method":"speed:Startup & brake","params":{},"steps":["Start and stop the platter with torque on low, then high; repeat 3x."],"equipment":["Stopwatch or the app timer"],"severity":"minor","software":null,"pass":null},{"id":"twelve-pitch-map","category":"pitch","title":"Pitch fader vs actual platter speed","why":"Compares ±8/±16/±50 % ranges with measured speed.","method":"speed:Pitch map","params":{"pitchPositions":[-8,-4,0,4,8]},"steps":["Set range ±8 %; move fader to marked positions and measure speed at each.","Repeat in ±16 and ±50 % (scale positions)."],"equipment":["Reference signal"],"severity":"major","software":null,"pass":null},{"id":"twelve-warmup","category":"speed","title":"Warm-up speed drift","why":"Drift while motor warms.","method":"speed:Warm-up speed","params":{},"steps":["Let the platter run 20 minutes."],"equipment":[],"severity":"minor","software":null,"pass":null},{"id":"twelve-vibration","category":"mechanical","title":"Platter vibration","why":"Motor or bearing wear.","method":"quick:Vibration","params":{},"steps":["Place a phone/probe on the plinth with platter running."],"equipment":[],"severity":"minor","software":null,"pass":null},{"id":"twelve-inspect","category":"mechanical","title":"Mechanical & visual inspection","why":"Platter wobble, loose slipmat, damaged USB port and worn buttons.","method":"manual:inspection","params":{},"steps":["Platter sits flat and rotates without rubbing or wobble.","Slipmat/control surface undamaged.","Pitch fader moves smoothly, no crackle.","USB-C port firm in socket.","Rubber feet and housing intact.","No unusual motor noise at either speed."],"equipment":[],"severity":"minor","software":null,"pass":null},{"id":"twelve-fw","category":"software","title":"Firmware up to date (Rane/inMusic updater)","why":"Outdated firmware can cause missing features with new software.","method":"manual:inspection","params":{},"steps":["Open the Rane firmware updater or Serato's device settings.","Note the installed firmware version and whether an update is offered.","Do not unplug during update."],"equipment":["Rane Twelve firmware updater (see documents)"],"severity":"minor","software":null,"pass":null},{"id":"twelve-traktor","category":"software","title":"Traktor / Virtual DJ MIDI operation","why":"Confirms generic MIDI usage works outside Serato.","method":"manual:inspection","params":{},"steps":["Open Traktor or VirtualDJ with the device selected.","Confirm platter and pitch move the deck; note mapping source used."],"equipment":[],"severity":"minor","software":"Traktor Pro","pass":null},{"id":"twelve-dvs-serato-control-tone","category":"timecode","title":"Serato Control Tone from the RCA outputs (generic signal check)","why":"The manufacturer documents a Serato Control Tone output for DVS. This checks the physical signal path and carrier health; it does not decode Serato's proprietary absolute position or guarantee software lock.","method":"timecode:format-check","params":{"format":"Serato CV02.5","sourceType":"hardware-generated control signal","nominalRpm":33.333333},"steps":["Connect the underside stereo RCA outputs to a Serato-enabled mixer/controller DVS input, then connect the mixer/controller to the capture device or choose its exposed input pair.","Set the Twelve MKII display to Serato DVS mode; start the platter and select Relative mode in Serato DJ Pro.","Run the generic format-check on the routed stereo signal while steady, then repeat while moving the platter slowly in both directions.","Interpret this as carrier/phase/balance/SNR/dropout evidence only. A result cannot certify absolute-position decoding or substitute for a Serato control-scope check."],"equipment":["Stereo RCA cables","Serato-enabled DVS mixer/controller","Available stereo capture input"],"severity":"major","software":"Serato DJ Pro","pass":null}]},{"schemaVersion":1,"id":"roland-dj-808","manufacturer":"Roland","model":"DJ-808","category":"controller","summary":"Hardware diagnostic research profile. Candidate features: jog,pad,fader,eq,audio,usb. Software: Serato DJ Pro.","identityNotes":"Research seed; the exact DJ-808 manual and Roland's 2024-03-29 rate-setting article enumerate 44.1, 48 and 96 kHz. The manual documents USB PC audio playback and controller MIDI through the PC port in standalone mode. Numeric USB audio input/output counts and USB stream bit depth remain unresolved: the manual distinguishes 24-bit A/D from 32-bit D/A conversion. Manual footer code 03 and copyright 2016 are document provenance, not firmware qualification. MIDI maps, USB IDs, class compliance, hardware revision, OS/firmware compatibility and physical performance remain unverified.","documents":[{"title":"Model specific official feature reference","type":"manual","url":"https://www.roland.com/global/products/dj-808/support/","language":"en"},{"title":"DJ-808 Owner's Manual, English footer code 03","type":"user-manual","url":"https://static.roland.com/assets/media/pdf/DJ-808_eng03_W.pdf","language":"en","notes":"Checked 2026-11-18. Copyright 2016; footer code 03; no exact release date identified. Printed p. 3 describes USB computer audio playback; p. 21 describes PC-port MIDI in standalone mode; p. 22 enumerates 44.1/48/96 kHz. Main Specifications, p. 32, distinguish 24-bit A/D and 32-bit D/A; no generic USB stream bit depth or channel count is established. Document code is not firmware."},{"title":"Driver and firmware support","type":"driver","url":"https://www.roland.com/global/support/","language":"en","notes":"Confirm OS-specific driver and version."},{"title":"DJ-808 Sampling Rate (System Setting), pad 1","type":"support-article","url":"https://support.roland.com/hc/en-us/articles/115002781883-DJ-808-Sampling-Rate-System-Setting-PAD-1","language":"en","notes":"Updated 2024-03-29; checked 2026-11-18. The exact-model sampling-rate setting lists 44.1, 48 and 96 kHz. This support-document date is not a firmware revision or physical qualification."},{"title":"Service manual","type":"service-manual","url":"","notes":"Not found/verified as publicly available."},{"title":"MIDI/HID map","type":"midi-message-list","url":"","notes":"Exact implementation mapping not verified; use learn mode and capture."}],"connectivity":{"usb":{"present":true,"vendorId":null,"productIds":[],"classCompliant":null},"midi":{"usbMidi":true,"din":null,"portNamePatterns":["DJ-808"]},"audio":{"usbChannelsIn":null,"usbChannelsOut":null,"sampleRatesHz":[44100,48000,96000],"bitDepth":null}},"software":[{"name":"Serato DJ Pro","role":"companion or operating mode; exact compatibility pending verification","minVersion":null}],"specs":[{"key":"candidate_capabilities","label":"Candidate hardware test groups","value":"jog,pad,fader,eq,audio,usb","unit":"","source":"https://www.roland.com/global/support/","confidence":"unverified","notes":"Model-dependent test planner; not exact control count or specification."},{"key":"verified_mixer_channels","label":"mixer channels","value":4,"unit":"count","source":"https://www.roland.com/global/products/dj-808/support/","confidence":"confirmed","notes":"Published manufacturer capability"},{"key":"verified_tr_s_drum_sequencer","label":"tr s drum sequencer","value":true,"unit":"bool","source":"https://www.roland.com/global/products/dj-808/support/","confidence":"confirmed","notes":"Published manufacturer capability"},{"key":"verified_vt_voice_transformer","label":"vt voice transformer","value":