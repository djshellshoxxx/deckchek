{
  "monitor_session_start": {
    "command": "monitor_session_start",
    "request": {
      "input": {
        "deviceName": "Traktor Audio 8 DJ",
        "hostApi": "WASAPI",
        "sampleRate": 48000,
        "format": "Traktor Scratch MK2",
        "config": { "decks": [{ "deck": "A", "first": 1 }, { "deck": "B", "first": 3 }], "hopMs": 250, "format": "Traktor Scratch MK2" },
        "assetId": null
      }
    },
    "response": { "id": "00000000-0000-4000-8000-000000000031", "startedAt": "2026-10-28T21:00:00.000Z" }
  },
  "monitor_log_append": {
    "command": "monitor_log_append",
