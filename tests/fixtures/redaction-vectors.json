[
 {
  "name": "profile literal",
  "ctx": {
   "user": "jsmith",
   "profile": "C:\\Users\\jsmith",
   "host": "DESKTOP-4F2K9Q",
   "serials": [
    "SN12345678"
   ]
  },
  "input": "open C:\\Users\\jsmith\\AppData\\Roaming\\com.x\\logs",
  "expected": "open <profile>\\AppData\\Roaming\\com.x\\logs"
 },
 {
  "name": "other drive and unknown user",
  "ctx": {},
  "input": "D:\\Users\\bob\\x",
  "expected": "D:\\Users\\<user>\\x"
 },
 {
  "name": "json escaped backslashes",
  "ctx": {},
  "input": "{\"p\":\"C:\\\\Users\\\\carol\\\\x\"}",
  "expected": "{\"p\":\"C:\\\\Users\\\\<user>\\\\x\"}"
 },
 {
  "name": "forward slashes and case",
  "ctx": {},
  "input": "c:/users/dave/file",
  "expected": "c:/users/<user>/file"
 },
 {
  "name": "username case-insensitive",
  "ctx": {
   "user": "jsmith",
   "profile": "C:\\Users\\jsmith",
   "host": "DESKTOP-4F2K9Q",
   "serials": [
    "SN12345678"
   ]
  },
  "input": "User JSMITH logged in as JSmith",
  "expected": "User <user> logged in as <user>"
 },
 {
  "name": "machine name",
  "ctx": {
   "user": "jsmith",
   "profile": "C:\\Users\\jsmith",
   "host": "DESKTOP-4F2K9Q",
   "serials": [
    "SN12345678"
   ]
  },
  "input": "host desktop-4f2k9q ok \\\\DESKTOP-4F2K9Q\\share",
  "expected": "host <host> ok \\\\<host>\\share"
 },
 {
  "name": "email",
  "ctx": {},
  "input": "contact Jo.Smith+tag@example.co.uk, or a@b",
  "expected": "contact <email>, or a@b"
 },
 {
  "name": "email containing the username",
  "ctx": {
   "user": "jsmith",
   "profile": "C:\\Users\\jsmith",
   "host": "DESKTOP-4F2K9Q",
   "serials": [
    "SN12345678"
   ]
  },
  "input": "jsmith@example.com",
  "expected": "<email>"
 },
 {
  "name": "serial labels",
  "ctx": {},
  "input": "Serial Number: AB12-CD34XY, S/N 99887766 serial: unknown serialize 12345678",
  "expected": "Serial Number: <serial>, S/N <serial> serial: unknown serialize 12345678"
 },
 {
  "name": "serial literal from asset",
  "ctx": {
   "user": "jsmith",
   "profile": "C:\\Users\\jsmith",
   "host": "DESKTOP-4F2K9Q",
   "serials": [
    "SN12345678"
   ]
  },
  "input": "device SN12345678 attached",
  "expected": "device <serial> attached"
 },
 {
  "name": "json serial_number",
  "ctx": {},
  "input": "\"serial_number\":\"ZX9A8B7C6D\"",
  "expected": "\"serial_number\":\"<serial>\""
 },
 {
  "name": "unicode user name",
  "ctx": {
   "user": "Zoë"
  },
  "input": "path /home/Zoë/x by ZOË",
  "expected": "path /home/<user>/x by <user>"
 },
 {
  "name": "two-letter user is token bounded",
  "ctx": {
   "user": "al"
  },
  "input": "Al said al is not alone; C:\\Users\\al\\x",
  "expected": "<user> said <user> is not alone; C:\\Users\\<user>\\x"
 },
 {
  "name": "placeholders are left alone",
  "ctx": {
   "user": "user"
  },
  "input": "<user> <profile> <email> <host> <serial>",
  "expected": "<user> <profile> <email> <host> <serial>"
 },
 {
  "name": "no false positives",
  "ctx": {},
  "input": "serial port COM3 opened; src/home/page; email me@ later",
  "expected": "serial port COM3 opened; src/home/page; email me@ later"
 },
 {
  "name": "unix homes",
  "ctx": {},
  "input": "cfg=/home/erin/.config and /Users/frank/Library",
  "expected": "cfg=/home/<user>/.config and /Users/<user>/Library"
 },
 {
  "name": "astral characters",
  "ctx": {},
  "input": "💥 C:\\Users\\😀name\\x",
  "expected": "💥 C:\\Users\\<user>\\x"
 },
 {
  "name": "short profile folder",
  "ctx": {},
  "input": "c:\\USERS\\JSMITH~1\\temp",
  "expected": "c:\\USERS\\<user>\\temp"
 },
 {
  "name": "env var names are not data",
  "ctx": {
   "user": "jsmith",
   "profile": "C:\\Users\\jsmith",
   "host": "DESKTOP-4F2K9Q",
   "serials": [
    "SN12345678"
   ]
  },
  "input": "%USERNAME% %USERPROFILE% %COMPUTERNAME%",
  "expected": "%USERNAME% %USERPROFILE% %COMPUTERNAME%"
 },
 {
  "name": "quoted Windows multiword profile and trailing prose",
  "ctx": {},
  "input": "open \"C:\\Users\\Casey Moss\\Logs\" failed",
  "expected": "open \"C:\\Users\\<user>\\Logs\" failed"
 },
 {
  "name": "single quoted Windows multiword profile without child",
  "ctx": {},
  "input": "profile='C:\\Users\\Casey Moss' ready",
  "expected": "profile='C:\\Users\\<user>' ready"
 },
 {
  "name": "quoted Unix Unicode multiword profile",
  "ctx": {},
  "input": "open \"/Users/Zoë Lark/Library\" ready",
  "expected": "open \"/Users/<user>/Library\" ready"
 },
 {
  "name": "parenthesized Unix multiword profile without child",
  "ctx": {},
  "input": "profile=(/home/Harper Finch) ready",
  "expected": "profile=(/home/<user>) ready"
 },
 {
  "name": "bracketed Unix multiword profile",
  "ctx": {},
  "input": "[/home/Harper Finch/.config] ready",
  "expected": "[/home/<user>/.config] ready"
 },
 {
  "name": "braced Windows multiword profile",
  "ctx": {},
  "input": "{C:\\Users\\Casey Moss\\Logs} ready",
  "expected": "{C:\\Users\\<user>\\Logs} ready"
 },
 {
  "name": "serialized JSON multiword path with escaped separators",
  "ctx": {},
  "input": "{\"path\":\"C:\\\\Users\\\\Casey Moss\\\\Logs\"}",
  "expected": "{\"path\":\"C:\\\\Users\\\\<user>\\\\Logs\"}"
 },
 {
  "name": "quoted case insensitive Windows prefix and repeated interior spaces",
  "ctx": {},
  "input": "\"c:/UsErS/Casey  Moss/logs\"",
  "expected": "\"c:/UsErS/<user>/logs\""
 },
 {
  "name": "wrapped multiword component after user literal replacement",
  "ctx": {
   "user": "Casey"
  },
  "input": "\"C:\\Users\\Casey Moss\\Logs\"",
  "expected": "\"C:\\Users\\<user>\\Logs\""
 },
 {
  "name": "wrapped multiword component with internal literal placeholder",
  "ctx": {
   "user": "Casey"
  },
  "input": "\"C:\\Users\\SummerCasey Moss\\Logs\"",
  "expected": "\"C:\\Users\\<user>\\Logs\""
 },
 {
  "name": "wrapped multiword component after email replacement",
  "ctx": {},
  "input": "\"/home/casey@example.org Moss/Logs\"",
  "expected": "\"/home/<user>/Logs\""
 },
 {
  "name": "wrapped exact multiword profile literal retains profile marker",
  "ctx": {
   "user": "Casey Moss",
   "profile": "C:\\Users\\Casey Moss"
  },
  "input": "\"C:\\Users\\Casey Moss\\Logs\"",
  "expected": "\"<profile>\\Logs\""
 },
 {
  "name": "wrapped marker without a space retains its existing kind",
  "ctx": {
   "host": "HARBOR"
  },
  "input": "\"C:\\Users\\HARBOR\\Logs\"",
  "expected": "\"C:\\Users\\<host>\\Logs\""
 },
 {
  "name": "bare multiword path remains a limited fallback",
  "ctx": {},
  "input": "C:\\Users\\Casey Moss\\Logs",
  "expected": "C:\\Users\\<user> Moss\\Logs"
 },
 {
  "name": "bare path does not consume following prose and later slash",
  "ctx": {},
  "input": "C:\\Users\\Casey logged in /ready",
  "expected": "C:\\Users\\<user> logged in /ready"
 },
 {
  "name": "quoted prose does not become a wrapped path value",
  "ctx": {},
  "input": "\"failed under C:\\Users\\Casey Moss\\Logs\"",
  "expected": "\"failed under C:\\Users\\<user> Moss\\Logs\""
 },
 {
  "name": "unclosed quote does not widen through child path",
  "ctx": {},
  "input": "\"C:\\Users\\Casey Moss\\Logs",
  "expected": "\"C:\\Users\\<user> Moss\\Logs"
 },
 {
  "name": "mismatched wrapper does not widen",
  "ctx": {},
  "input": "[C:\\Users\\Casey Moss\\Logs)",
  "expected": "[C:\\Users\\<user> Moss\\Logs)"
 },
 {
  "name": "nested child wrapper does not authorize widening",
  "ctx": {},
  "input": "[C:\\Users\\Casey Moss\\Logs[1]]",
  "expected": "[C:\\Users\\<user> Moss\\Logs[1]]"
 },
 {
  "name": "trailing component space does not authorize widening",
  "ctx": {},
  "input": "\"/home/Harper Finch \" ready",
  "expected": "\"/home/<user> Finch \" ready"
 },
 {
  "name": "hard punctuation keeps conservative profile boundary",
  "ctx": {},
  "input": "\"/home/Harper Finch, notes\" ready",
  "expected": "\"/home/<user> Finch, notes\" ready"
 },
 {
  "name": "wrapper close beyond newline does not widen",
  "ctx": {},
  "input": "\"C:\\Users\\Casey Moss\\Logs\nready\"",
  "expected": "\"C:\\Users\\<user> Moss\\Logs\nready\""
 },
 {
  "name": "wrapper close beyond tab does not widen",
  "ctx": {},
  "input": "\"C:\\Users\\Casey Moss\\Logs\tready\"",
  "expected": "\"C:\\Users\\<user> Moss\\Logs\tready\""
 },
 {
  "name": "wrapper close beyond NBSP does not widen",
  "ctx": {},
  "input": "\"C:\\Users\\Casey Moss\\Logs\u00a0ready\"",
  "expected": "\"C:\\Users\\<user> Moss\\Logs\u00a0ready\""
 },
 {
  "name": "wrapper close beyond NEL does not widen",
  "ctx": {},
  "input": "\"C:\\Users\\Casey Moss\\Logs\u0085ready\"",
  "expected": "\"C:\\Users\\<user> Moss\\Logs\u0085ready\""
 },
 {
  "name": "wrapper close beyond BOM does not widen",
  "ctx": {},
  "input": "\"C:\\Users\\Casey Moss\\Logs\ufeffready\"",
  "expected": "\"C:\\Users\\<user> Moss\\Logs\ufeffready\""
 },
 {
  "name": "wrapper close beyond Unicode line separator does not widen",
  "ctx": {},
  "input": "\"C:\\Users\\Casey Moss\\Logs\u2028ready\"",
  "expected": "\"C:\\Users\\<user> Moss\\Logs\u2028ready\""
 },
 {
  "name": "quoted non-profile program path stays unchanged",
  "ctx": {},
  "input": "\"C:\\Program Files\\DeckChek\" ready",
  "expected": "\"C:\\Program Files\\DeckChek\" ready"
 }
]
