{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeckChek",
  "version": "0.1.0",
  "identifier": "com.circuitdriftlabs.deckchek",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "DeckChek",
        "width": 1440,
        "height": 980,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
